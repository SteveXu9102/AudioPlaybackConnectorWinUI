<?xml version="1.0" encoding="utf-8"?>
<!--
    FluentView - the device panel shown when the notification-area icon is
    clicked.

    Follows current Fluent Design guidance: an opaque themed surface (provided by
    the hosting window), layered card surfaces with 8px corner radii, the Fluent
    type ramp, themed colour tokens, Segoe Fluent Icons and an entrance
    transition on the device list.

    Application-level settings and commands live in the right-click context menu
    (ContextMenuView), so this panel stays focused on connecting devices; a
    device's own commands (reconnect on the next start, remove the device) live in
    that device's card, behind the ellipsis button on its row.
-->
<UserControl
    x:Class="AudioPlaybackConnectorWinUI.FluentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Palette probe.

            Device rows are created in code, so they need brush instances at
            runtime. Reading them from these zero-sized elements keeps every
            Fluent colour token declared in markup and resolved by the theme
            system, instead of hard-coding colours in C++.
        -->
        <StackPanel Visibility="Collapsed" Width="0" Height="0">
            <Border x:Name="ProbeCardBackground" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Border x:Name="ProbeCardBorder" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Border x:Name="ProbeSecondaryText" BorderBrush="{ThemeResource TextFillColorSecondaryBrush}" />
            <Border x:Name="ProbeTertiaryText" BorderBrush="{ThemeResource TextFillColorTertiaryBrush}" />
            <Border x:Name="ProbeAccentText" BorderBrush="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <Border x:Name="ProbeAccentFill" Background="{ThemeResource AccentFillColorDefaultBrush}" />
            <Border x:Name="ProbeError" BorderBrush="{ThemeResource SystemFillColorCriticalBrush}" />
        </StackPanel>

        <!-- Header: application identity. -->
        <StackPanel Grid.Row="0" Padding="20,18,20,10" Spacing="4">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image
                    x:Name="AppIconImage"
                    Width="40"
                    Height="40"
                    Stretch="Uniform"
                    VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        x:Name="TitleText"
                        FontSize="18"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock
                            x:Name="SubtitleText"
                            FontSize="12"
                            TextTrimming="CharacterEllipsis" />
                        <!--
                            The version of the running executable, read from its own
                            version resource, so a report can name the exact build.
                        -->
                        <TextBlock
                            x:Name="VersionText"
                            FontSize="12"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Devices -->
        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="20,4,20,16" Spacing="8">
                <!-- Devices heading, with the pairing action on its trailing edge. -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Name="DevicesHeaderText"
                        FontSize="12"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />

                    <Button
                        x:Name="PairButton"
                        Grid.Column="1"
                        Padding="10,3,10,3"
                        FontSize="12"
                        BorderThickness="1"
                        CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock x:Name="PairButtonText" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock
                    x:Name="EmptyStateText"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />

                <StackPanel x:Name="DevicePanel" Spacing="8">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="14" />
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
