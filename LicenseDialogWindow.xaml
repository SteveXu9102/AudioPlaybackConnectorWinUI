<?xml version="1.0" encoding="utf-8"?>
<!--
    LicenseDialogWindow - the licence information, in a window of its own.

    The tray popup is sized exactly to its content and the confirmation dialog is
    only wide enough for a sentence, so the licence texts get a window of a fixed
    size instead: a scrollable, selectable body and one button to close it.

    Like the other windows it paints its own opaque, themed Fluent surface.
-->
<Window
    x:Class="AudioPlaybackConnectorWinUI.LicenseDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" />

        <Grid x:Name="Content" Padding="24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="LicenseDialogTitle" />

            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <!-- AutomationId so the text this window shows can be read from UI
                     Automation, which is how a test can tell that the embedded copy is
                     what is displayed. -->
                <TextBlock
                    x:Name="LicenseText"
                    AutomationProperties.AutomationId="LicenseDialogText"
                    FontSize="13"
                    IsTextSelectionEnabled="True"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </ScrollViewer>

            <Button
                x:Name="CloseButton"
                Grid.Row="2"
                MinWidth="104"
                HorizontalAlignment="Right"
                HorizontalContentAlignment="Center" />
        </Grid>
    </Grid>
</Window>
