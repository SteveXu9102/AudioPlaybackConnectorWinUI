<?xml version="1.0" encoding="utf-8"?>
<!--
    ConfirmDialogWindow - a confirmation the user has to answer.

    It is a separate window rather than a ContentDialog because the tray popup is
    sized exactly to its content: an in-window dialog would be squeezed into that
    small surface.

    Like the popup it paints its own opaque, themed Fluent surface.
-->
<Window
    x:Class="AudioPlaybackConnectorWinUI.ConfirmDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" />

        <StackPanel x:Name="Content" Padding="24" Spacing="20">
            <StackPanel Spacing="8">
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                <!--
                    The warning text takes its brush straight from the theme rather
                    than from a probe read in code: the dialog is created once and
                    then reused, so a brush captured at construction kept the theme
                    the dialog was first shown in.
                -->
                <TextBlock
                    x:Name="MessageText"
                    FontSize="14"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="CancelButton" MinWidth="104" HorizontalContentAlignment="Center" />
                <Button x:Name="ConfirmButton" MinWidth="104" HorizontalContentAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
