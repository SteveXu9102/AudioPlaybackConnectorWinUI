// Project.idl
//
// Runtime classes with an associated XAML file must be declared here so that
// C++/WinRT generates their activation factories and public interfaces.
//
// App itself is generated by the XAML compiler from App.xaml and is therefore
// deliberately not declared here.

namespace AudioPlaybackConnectorWinUI
{
    /// <summary>
    /// The notification-area popup. It shows the device panel or the context
    /// menu and is the only visible window of the application.
    /// </summary>
    [default_interface]
    runtimeclass TrayWindow : Microsoft.UI.Xaml.Window
    {
        TrayWindow();

        /// <summary>Shows the device panel near the notification-area icon, or hides it when already open.</summary>
        void Toggle();

        /// <summary>Shows the context menu near the notification-area icon, or hides it when already open.</summary>
        void ShowContextMenu();

        void HidePopup();

        /// <summary>Rebuilds the visible content from the live device state.</summary>
        void RefreshDevices();
    }

    /// <summary>The Fluent Design device panel shown for a left click.</summary>
    [default_interface]
    runtimeclass FluentView : Microsoft.UI.Xaml.Controls.UserControl
    {
        FluentView();

        /// <summary>Rebuilds the panel from the current settings and device state.</summary>
        void Refresh();

        /// <summary>Slides the device cards into place.</summary>
        void PlayEntranceAnimation();
    }

    /// <summary>The context menu shown for a right click.</summary>
    [default_interface]
    runtimeclass ContextMenuView : Microsoft.UI.Xaml.Controls.UserControl
    {
        ContextMenuView();

        /// <summary>Rebuilds the menu items from the current settings.</summary>
        void Refresh();

        /// <summary>Slides the menu items into place, in sequence.</summary>
        void PlayEntranceAnimation();

        /// <summary>Moves keyboard focus to the first menu item.</summary>
        void FocusFirstItem();
    }

    /// <summary>
    /// A confirmation the user has to answer (exiting, removing a device). A
    /// separate window, because the tray popup is sized exactly to its content
    /// and an in-window dialog would be squeezed into it.
    ///
    /// The popup fills it in and supplies the action to run on confirmation
    /// through the implementation type, so nothing else is exposed here.
    /// </summary>
    [default_interface]
    runtimeclass ConfirmDialogWindow : Microsoft.UI.Xaml.Window
    {
        ConfirmDialogWindow();
    }

    /// <summary>
    /// The licence information, in a window of its own, for the same reason as
    /// the confirmation: the text is long and the popup is sized to its content.
    ///
    /// The popup fills in the text and the theme through the implementation type,
    /// so nothing else is exposed here.
    /// </summary>
    [default_interface]
    runtimeclass LicenseDialogWindow : Microsoft.UI.Xaml.Window
    {
        LicenseDialogWindow();
    }
}
